# Local development. For hosted deployments replace this with the public
# Railway HTTPS URL, including /api/v1 and without a trailing slash.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# This opt-in is only for a private dashboard behind the project's Caddy.
# Leave false on managed hosting (Netlify / Vercel).
GARAGEOS_TRUST_CADDY_IP=false

NEXT_TELEMETRY_DISABLED=1
