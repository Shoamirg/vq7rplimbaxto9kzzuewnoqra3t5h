# Railway Variables > Raw Editor. Service names must match Postgres and Redis.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
ENVIRONMENT=production
DEBUG=false
DATABASE_ECHO=false
DEMO_MODE_ENABLED=false
SECRET_KEY=__CHANGE_ME_generate_a_private_random_secret__
CORS_ORIGINS=https://garageos.uz
WEB_CONCURRENCY=1
TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# Mobile sign-up / password reset codes. Until Eskiz is set up keep "disabled":
# those endpoints answer 503 and everything else works. SMS_CODE_TEMPLATE must
# match a template approved in the Eskiz cabinet and contain {code}.
SMS_PROVIDER=disabled
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_SENDER=4546
SMS_CODE_TEMPLATE=GarageOS tasdiqlash kodi: {code}
CUSTOMER_REFRESH_IDLE_DAYS=60
CUSTOMER_SESSION_MAX_DAYS=365
# Push notifications to the Expo app: "disabled" or "expo". EXPO_ACCESS_TOKEN
# only if "Enhanced push security" is on in the Expo project.
PUSH_PROVIDER=disabled
EXPO_ACCESS_TOKEN=
# Uploaded photos. Must be an absolute path on a persistent, backed-up disk.
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=10485760
