# Railway Variables > Raw Editor. Service names must match Postgres and Redis.
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
ENVIRONMENT=production
DEBUG=false
DATABASE_ECHO=false
DEMO_MODE_ENABLED=false
SECRET_KEY=__CHANGE_ME_generate_a_private_random_secret__
CORS_ORIGINS=https://garageos.uz
WEB_CONCURRENCY=1
TRUST_PROXY_HEADERS=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX=60
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
