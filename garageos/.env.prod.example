# GarageOS production environment. Copy to .env.prod and fill in REAL secrets.
# NEVER commit .env.prod. Generate secrets with: openssl rand -hex 32

# ── Domain / TLS ────────────────────────────────────────────────────────────
DOMAIN=app.garageos.example          # the public hostname (A record → this host)
ACME_EMAIL=ops@garageos.example      # Let's Encrypt contact

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=garage_prod
POSTGRES_PASSWORD=__CHANGE_ME_strong_password__
POSTGRES_DB=garage_platform

# ── Backend security ────────────────────────────────────────────────────────
SECRET_KEY=__CHANGE_ME_openssl_rand_hex_32__   # JWT signing — rotate on exposure
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Public origin(s) allowed by CORS — your domain only.
CORS_ORIGINS=https://app.garageos.example
# Serving workers (roughly = CPU cores).
WEB_CONCURRENCY=4

# ── Telegram ────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=__CHANGE_ME_from_BotFather__   # rotate before launch
# The public HTTPS URL of the Mini App — used by setup_bot.py + the bot button.
TELEGRAM_MINI_APP_URL=https://app.garageos.example/mini

# ── Payments (Phase 12 · Week 3 — leave blank until wired) ──────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ── Object storage (attachments — S3 / Cloudflare R2; leave blank until wired)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Observability (optional but recommended) ────────────────────────────────
# SENTRY_DSN=
