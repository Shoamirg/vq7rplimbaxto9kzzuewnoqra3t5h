# GarageOS production environment. Copy to .env.prod and fill in REAL secrets.
# NEVER commit .env.prod. Generate secrets with: openssl rand -hex 32
# Validate: python scripts/production_preflight.py --env-file .env.prod
# Telegram is off by default; add --profile telegram only after configuring it.

# ── Domain / TLS ────────────────────────────────────────────────────────────
DOMAIN=garageos.uz                   # the public hostname (A record → this host)
ACME_EMAIL=ops@garageos.example      # replace with a real Let's Encrypt contact email

# ── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=garage_prod
POSTGRES_PASSWORD=__CHANGE_ME_strong_password__
# Use the generated hexadecimal password so the Compose DATABASE_URL remains valid.
POSTGRES_DB=garage_platform

# ── Backend security ────────────────────────────────────────────────────────
SECRET_KEY=__CHANGE_ME_openssl_rand_hex_32__   # JWT signing — rotate on exposure
ENVIRONMENT=production
DEBUG=false
DATABASE_ECHO=false
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Public origin(s) allowed by CORS — your domain only.
CORS_ORIGINS=https://garageos.uz
# Serving workers (roughly = CPU cores).
WEB_CONCURRENCY=4

# ── Rate limiting (Redis-backed; degrades open if Redis is down) ────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_MAX=10          # login/refresh/telegram attempts per IP per window
RATE_LIMIT_AUTH_WINDOW_SECONDS=60
RATE_LIMIT_WRITE_MAX=60         # write ops per IP per window
RATE_LIMIT_WRITE_WINDOW_SECONDS=60
# Behind Caddy the real client IP is in X-Forwarded-For — trust it.
TRUST_PROXY_HEADERS=true

# ── Optional Telegram (docker compose --profile telegram ...) ────────────────
TELEGRAM_BOT_TOKEN=   # Fill from BotFather only when enabling the telegram profile.
# The public HTTPS URL of the Mini App — used by setup_bot.py + the bot button.
TELEGRAM_MINI_APP_URL=https://garageos.uz/mini

# ── Payments (Phase 12 · Week 3 — leave blank until wired) ──────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PUBLISHABLE_KEY=

# ── Object storage (attachments — S3 / Cloudflare R2; leave blank until wired)
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Observability (optional but recommended) ────────────────────────────────
# Error monitoring activates only when SENTRY_DSN is set; a no-op otherwise.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1        # 0.0 = errors only, no performance tracing
# SENTRY_ENVIRONMENT=production        # defaults to ENVIRONMENT

# ── Public demo (garageos.com/demo) ─────────────────────────────────────────
# Turn on to let anyone explore the demo tenant with no signup. Sessions are
# READ-ONLY (writes are rejected), so the demo data stays pristine — no reset
# needed. Requires the demo tenant to be seeded (python -m app.seeds.demo --fresh).
DEMO_MODE_ENABLED=false
DEMO_EMAIL=admin@demo.garageos.app
