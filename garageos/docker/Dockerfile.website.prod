# Production image for the public landing website (Next.js standalone).
# Build context: ./website — the site is self-contained (own lockfile, no
# workspace packages).
FROM node:22-alpine AS deps
WORKDIR /site
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /site
# "Sign in" / "Live demo" redirect targets are baked in at build time.
ARG APP_URL=https://app.garageos.uz
ENV APP_URL=$APP_URL NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /site/node_modules ./node_modules
COPY . .
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
RUN addgroup -S nodejs && adduser -S nextjs -G nodejs
COPY --from=builder --chown=nextjs:nodejs /site/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /site/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /site/public ./public
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
