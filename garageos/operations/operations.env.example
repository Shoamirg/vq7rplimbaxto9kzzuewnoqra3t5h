# Non-secret operator settings; actual file stays outside the checkout.
# An existing separate SSH backup host/directory and verified host key are required.
BACKUP_SSH_TARGET=backupuser@backup-host.example
BACKUP_SSH_DIRECTORY=/private/garageos-backups
BACKUP_SSH_IDENTITY_FILE=/etc/garageos/backup_ed25519
BACKUP_SSH_KNOWN_HOSTS=/etc/garageos/backup_known_hosts
BACKUP_SSH_PORT=22
