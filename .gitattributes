# Normalize line endings: store everything as LF in the repo, regardless of OS.
* text=auto eol=lf

# Treat known binaries as binary (never normalize).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
